{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/environments/minecraft/schemas/observation-payload.schema.json",
  "title": "MinecraftObservationPayload",
  "description": "What a Minecraft observation reports, as Person perceives it: owned by the Minecraft environment profile, carried in Observation.payload. Bounded, relative, semantic; never a raw Mineflayer object, never a world coordinate (ADR 0002, ADR 0025).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vitals",
    "environment",
    "inventory",
    "permissions",
    "affordances",
    "nearby",
    "home",
    "navigation"
  ],
  "properties": {
    "vitals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "food",
        "breath",
        "armor",
        "statusEffects",
        "alive"
      ],
      "properties": {
        "health": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "food": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "breath": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Breath as a player sees it: bubbles, 10 when full. Not the server's air counter (ADR 0014)."
        },
        "armor": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "statusEffects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "amplifier", "remainingTicks"],
            "properties": {
              "name": {
                "$ref": "https://person.local/schemas/common.schema.json#/$defs/identifier"
              },
              "amplifier": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "remainingTicks": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "alive": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "dayPhase",
        "timeOfDay",
        "weather",
        "lightLevel",
        "biome"
      ],
      "properties": {
        "dimension": {
          "enum": ["overworld", "nether", "end"]
        },
        "dayPhase": {
          "enum": ["dawn", "day", "dusk", "night"]
        },
        "timeOfDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23999
        },
        "weather": {
          "enum": ["clear", "rain", "thunder"]
        },
        "lightLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "biome": {
          "$ref": "https://person.local/schemas/common.schema.json#/$defs/identifier"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "categories", "freeSlots"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://person.local/schemas/common.schema.json#/$defs/itemStack"
          }
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "food",
            "raw_food",
            "cooked_food",
            "fuel",
            "wood",
            "stone",
            "coal",
            "tools",
            "weapons",
            "armor",
            "building_materials"
          ],
          "properties": {
            "food": {
              "type": "integer",
              "minimum": 0
            },
            "raw_food": {
              "type": "integer",
              "minimum": 0
            },
            "cooked_food": {
              "type": "integer",
              "minimum": 0
            },
            "fuel": {
              "type": "integer",
              "minimum": 0
            },
            "wood": {
              "type": "integer",
              "minimum": 0
            },
            "stone": {
              "type": "integer",
              "minimum": 0
            },
            "coal": {
              "type": "integer",
              "minimum": 0
            },
            "tools": {
              "type": "integer",
              "minimum": 0
            },
            "weapons": {
              "type": "integer",
              "minimum": 0
            },
            "armor": {
              "type": "integer",
              "minimum": 0
            },
            "building_materials": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "freeSlots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "What the runtime would currently allow. Cognition reads these instead of reading configuration, so the authoritative answer always comes from the side that enforces it.",
      "additionalProperties": false,
      "required": [
        "harvest",
        "mine",
        "build",
        "huntPassive",
        "depositOwned",
        "withdrawOwned",
        "withdrawExisting",
        "craft",
        "consume"
      ],
      "properties": {
        "harvest": {
          "type": "boolean"
        },
        "mine": {
          "type": "boolean"
        },
        "build": {
          "type": "boolean"
        },
        "huntPassive": {
          "type": "boolean"
        },
        "depositOwned": {
          "type": "boolean"
        },
        "withdrawOwned": {
          "type": "boolean"
        },
        "withdrawExisting": {
          "type": "boolean"
        },
        "craft": {
          "type": "boolean"
        },
        "consume": {
          "type": "boolean"
        }
      }
    },
    "affordances": {
      "type": "object",
      "description": "Runtime-only knowledge the cognition process cannot derive from the rest of the observation.",
      "additionalProperties": false,
      "required": ["diggableGround", "shelterSite", "storageSite"],
      "properties": {
        "diggableGround": {
          "type": "boolean"
        },
        "shelterSite": {
          "type": "boolean"
        },
        "storageSite": {
          "type": "boolean"
        }
      }
    },
    "nearby": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "hostiles",
        "passiveAnimals",
        "players",
        "containers",
        "workstations",
        "hazards"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "distance",
              "harvestPermitted",
              "bearing",
              "elevation",
              "rangeBand",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": ["wood", "stone", "coal", "plant_food", "dirt", "other"]
              },
              "name": {
                "$ref": "https://person.local/schemas/common.schema.json#/$defs/identifier"
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "harvestPermitted": {
                "type": "boolean"
              },
              "bearing": {
                "type": "string",
                "enum": [
                  "ahead",
                  "ahead_left",
                  "ahead_right",
                  "left",
                  "right",
                  "behind_left",
                  "behind_right",
                  "behind"
                ],
                "description": "Direction relative to where Person is facing. Person has no compass."
              },
              "elevation": {
                "type": "string",
                "enum": ["above", "level", "below"]
              },
              "rangeBand": {
                "type": "string",
                "enum": ["reach", "near", "mid", "far"]
              },
              "detail": {
                "type": "string",
                "enum": ["central", "peripheral"],
                "description": "Whether Person was looking at this or merely aware of it. A peripheral percept withholds precise identity."
              }
            }
          }
        },
        "hostiles": {
          "$ref": "#/$defs/entityList"
        },
        "passiveAnimals": {
          "$ref": "#/$defs/entityList"
        },
        "players": {
          "$ref": "#/$defs/entityList"
        },
        "containers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "distance",
              "provenance",
              "storageId",
              "bearing",
              "elevation",
              "rangeBand",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": ["chest", "barrel", "furnace", "shulker", "other"]
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "provenance": {
                "enum": ["owned", "existing"]
              },
              "storageId": {
                "oneOf": [
                  {
                    "$ref": "https://person.local/schemas/common.schema.json#/$defs/slug"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bearing": {
                "type": "string",
                "enum": [
                  "ahead",
                  "ahead_left",
                  "ahead_right",
                  "left",
                  "right",
                  "behind_left",
                  "behind_right",
                  "behind"
                ],
                "description": "Direction relative to where Person is facing. Person has no compass."
              },
              "elevation": {
                "type": "string",
                "enum": ["above", "level", "below"]
              },
              "rangeBand": {
                "type": "string",
                "enum": ["reach", "near", "mid", "far"]
              },
              "detail": {
                "type": "string",
                "enum": ["central", "peripheral"],
                "description": "Whether Person was looking at this or merely aware of it. A peripheral percept withholds precise identity."
              }
            }
          }
        },
        "workstations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "distance",
              "provenance",
              "bearing",
              "elevation",
              "rangeBand",
              "detail",
              "source"
            ],
            "properties": {
              "kind": {
                "enum": ["crafting_table", "furnace", "anvil", "other"]
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "provenance": {
                "enum": ["owned", "existing"]
              },
              "bearing": {
                "type": "string",
                "enum": [
                  "ahead",
                  "ahead_left",
                  "ahead_right",
                  "left",
                  "right",
                  "behind_left",
                  "behind_right",
                  "behind"
                ],
                "description": "Direction relative to where Person is facing. Person has no compass."
              },
              "elevation": {
                "type": "string",
                "enum": ["above", "level", "below"]
              },
              "rangeBand": {
                "type": "string",
                "enum": ["reach", "near", "mid", "far"]
              },
              "detail": {
                "type": "string",
                "enum": ["central", "peripheral"],
                "description": "Whether Person was looking at this or merely aware of it. A peripheral percept withholds precise identity."
              },
              "source": {
                "type": "string",
                "const": "placement_ledger",
                "description": "Read from the runtime's placement ledger of what Person built, rather than seen. Not a recollection."
              }
            }
          }
        },
        "hazards": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "distance",
              "bearing",
              "elevation",
              "rangeBand",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "lava",
                  "fire",
                  "water",
                  "cactus",
                  "magma",
                  "fall",
                  "suffocation",
                  "other"
                ]
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "bearing": {
                "type": "string",
                "enum": [
                  "ahead",
                  "ahead_left",
                  "ahead_right",
                  "left",
                  "right",
                  "behind_left",
                  "behind_right",
                  "behind"
                ],
                "description": "Direction relative to where Person is facing. Person has no compass."
              },
              "elevation": {
                "type": "string",
                "enum": ["above", "level", "below"]
              },
              "rangeBand": {
                "type": "string",
                "enum": ["reach", "near", "mid", "far"]
              },
              "detail": {
                "type": "string",
                "enum": ["central", "peripheral"],
                "description": "Whether Person was looking at this or merely aware of it. A peripheral percept withholds precise identity."
              }
            }
          }
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeHome",
        "shelterState",
        "ownedStorage",
        "bedKnown",
        "foodReserve",
        "fuelReserve"
      ],
      "properties": {
        "activeHome": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["homeId"],
              "properties": {
                "homeId": {
                  "$ref": "https://person.local/schemas/common.schema.json#/$defs/slug"
                }
              }
            }
          ]
        },
        "shelterState": {
          "enum": ["none", "partial", "complete", "breached", "unknown"]
        },
        "ownedStorage": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storageId", "contents"],
            "properties": {
              "storageId": {
                "$ref": "https://person.local/schemas/common.schema.json#/$defs/slug"
              },
              "contents": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "https://person.local/schemas/common.schema.json#/$defs/itemStack"
                }
              }
            }
          }
        },
        "bedKnown": {
          "type": "boolean"
        },
        "foodReserve": {
          "type": "integer",
          "minimum": 0
        },
        "fuelReserve": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeStatus", "pathRisk", "stuckState", "returnPathKnown"],
      "properties": {
        "routeStatus": {
          "enum": ["idle", "ok", "blocked", "unknown"]
        },
        "pathRisk": {
          "enum": ["low", "moderate", "high"]
        },
        "stuckState": {
          "enum": ["free", "slow", "stuck"]
        },
        "returnPathKnown": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "entityList": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["distance", "bearing", "elevation", "rangeBand", "detail"],
        "properties": {
          "name": {
            "$ref": "https://person.local/schemas/common.schema.json#/$defs/identifier"
          },
          "distance": {
            "type": "number",
            "minimum": 0
          },
          "named": {
            "type": "boolean"
          },
          "tamed": {
            "type": "boolean"
          },
          "protectedTarget": {
            "type": "boolean",
            "description": "True when the runtime forbids this entity as a hunting target for any reason."
          },
          "username": {
            "$ref": "#/$defs/minecraftUsername",
            "description": "Present when the client knows the account name. Players always have one; mobs never do."
          },
          "bearing": {
            "type": "string",
            "enum": [
              "ahead",
              "ahead_left",
              "ahead_right",
              "left",
              "right",
              "behind_left",
              "behind_right",
              "behind"
            ],
            "description": "Direction relative to where Person is facing. Person has no compass."
          },
          "elevation": {
            "type": "string",
            "enum": ["above", "level", "below"]
          },
          "rangeBand": {
            "type": "string",
            "enum": ["reach", "near", "mid", "far"]
          },
          "detail": {
            "type": "string",
            "enum": ["central", "peripheral"],
            "description": "Whether Person was looking at this or merely aware of it. A peripheral percept withholds precise identity."
          }
        },
        "if": {
          "properties": {
            "detail": {
              "const": "central"
            }
          }
        },
        "then": {
          "properties": {
            "named": {
              "type": "boolean"
            },
            "tamed": {
              "type": "boolean"
            },
            "protectedTarget": {
              "type": "boolean"
            }
          },
          "required": ["named", "tamed", "protectedTarget"]
        },
        "else": {
          "description": "In the periphery there is something at a bearing. What it is and whose it is are withheld, and so is the hunting verdict derived from them.",
          "properties": {
            "name": false,
            "named": false,
            "tamed": false,
            "protectedTarget": false,
            "username": false
          }
        }
      }
    },
    "minecraftUsername": {
      "type": "string",
      "description": "A Minecraft account name. Mixed case and digits are ordinary, so this cannot reuse the lowercase identifier pattern.",
      "pattern": "^[A-Za-z0-9_]{1,16}$"
    }
  }
}
