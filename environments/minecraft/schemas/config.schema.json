{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/environments/minecraft/schemas/config.schema.json",
  "title": "MinecraftConfig",
  "description": "The configuration the Minecraft environment owns (ADR 0025): its difficulty, its embodiments, its world geometry and its capability pins. Composed with the core configuration schema by environment.kind; several capabilities are pinned to a single legal value so no configuration edit can turn them on.",
  "type": "object",
  "required": ["environment", "runtime", "world", "permissions"],
  "properties": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "minecraft"
        },
        "difficulty": {
          "enum": ["peaceful", "normal"],
          "description": "Server difficulty the Mineflayer embodiment expects. Required for mineflayer, absent for fixture, whose world defines its own dynamics. It partitions learning evidence as the environment variant."
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "embodiment": {
          "enum": ["fixture", "mineflayer"],
          "description": "fixture: the deterministic fixture world. mineflayer: a Minecraft Java 1.16.1 server through Mineflayer. Both are embodiments of the one Minecraft environment."
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "version"],
      "properties": {
        "host": {
          "enum": ["127.0.0.1", "localhost", "::1"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "version": {
          "const": "1.16.1"
        }
      }
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "auth"],
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{3,16}$"
        },
        "auth": {
          "const": "offline"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldOwnerApproved",
        "dedicatedIdentity",
        "resourceAreasAreUnowned",
        "naturalDaylightCycle"
      ],
      "properties": {
        "worldOwnerApproved": {
          "const": true
        },
        "dedicatedIdentity": {
          "const": true
        },
        "resourceAreasAreUnowned": {
          "const": true
        },
        "naturalDaylightCycle": {
          "const": true
        },
        "normalDifficulty": {
          "type": "boolean"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "exploration", "resourceAreas", "protectedAreas"],
      "properties": {
        "home": {
          "$ref": "#/$defs/position"
        },
        "exploration": {
          "$ref": "#/$defs/box"
        },
        "resourceAreas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/box"
          }
        },
        "protectedAreas": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/box"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers",
        "hunting",
        "players",
        "villagers",
        "building",
        "protectedAreas"
      ],
      "properties": {
        "containers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existing", "owned"],
          "properties": {
            "existing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["withdraw", "deposit"],
              "properties": {
                "withdraw": {
                  "type": "boolean"
                },
                "deposit": {
                  "const": false,
                  "description": "Person never alters a container it did not place. This value has exactly one legal setting."
                }
              }
            },
            "owned": {
              "type": "object",
              "additionalProperties": false,
              "required": ["withdraw", "deposit"],
              "properties": {
                "withdraw": {
                  "type": "boolean"
                },
                "deposit": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "hunting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passiveUnnamedAnimals", "namedAnimals", "tamedAnimals"],
          "properties": {
            "passiveUnnamedAnimals": {
              "type": "boolean"
            },
            "namedAnimals": {
              "const": false
            },
            "tamedAnimals": {
              "const": false
            }
          }
        },
        "players": {
          "type": "object",
          "additionalProperties": false,
          "required": ["combat"],
          "properties": {
            "combat": {
              "const": false
            }
          }
        },
        "villagers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harm"],
          "properties": {
            "harm": {
              "const": false
            }
          }
        },
        "building": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "protectedAreas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enforcement"],
          "properties": {
            "enforcement": {
              "const": "strict"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "runtime": {
            "type": "object",
            "properties": {
              "embodiment": {
                "const": "mineflayer"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "object",
            "properties": {
              "difficulty": {
                "enum": ["peaceful", "normal"]
              }
            },
            "required": ["difficulty"]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "object",
            "not": {
              "type": "object",
              "properties": {
                "difficulty": {
                  "enum": ["peaceful", "normal"]
                }
              },
              "required": ["difficulty"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "type": "integer",
          "minimum": -64,
          "maximum": 320
        },
        "z": {
          "type": "integer",
          "minimum": -30000000,
          "maximum": 30000000
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "$ref": "#/$defs/position"
        },
        "max": {
          "$ref": "#/$defs/position"
        }
      }
    }
  }
}
