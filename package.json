{
  "name": "person",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Person: a persistent autonomous artificial inhabitant for Minecraft (Node runtime and safety boundary)",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "bin": {
    "person": "apps/cli/src/bin/person.ts",
    "shroud": "apps/cli/src/bin/person.ts"
  },
  "imports": {
    "#protocol": "./packages/protocol/ts/index.ts",
    "#skills": "./packages/skills/ts/index.ts",
    "#config": "./packages/config/ts/index.ts",
    "#fixture-world": "./fixtures/src/index.ts",
    "#minecraft-adapter": "./adapters/minecraft/src/index.ts",
    "#node-runtime": "./apps/node-runtime/src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 \"packages/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:unit": "node --test --test-concurrency=1 \"packages/**/*.test.ts\" \"tests/skills/**/*.test.ts\" \"tests/safety/**/*.test.ts\" \"tests/cli/**/*.test.ts\" \"tests/observation/**/*.test.ts\" \"tests/validation/**/*.test.ts\" \"tests/architecture/**/*.test.ts\" \"tests/adapter/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run build && npm run format:check && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "smol-toml": "1.8.0",
    "vec3": "0.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
