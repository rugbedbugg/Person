{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/schemas/person-config.schema.json",
  "title": "PersonConfig",
  "description": "Runtime configuration. Capabilities are explicit and several of them are pinned to a single legal value so no configuration edit can turn them on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "personId",
    "worldId",
    "runtime",
    "learning",
    "cognition",
    "world",
    "permissions"
  ],
  "properties": {
    "configVersion": { "const": 2 },
    "personId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "worldId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embodiment", "trainingContext", "outputDirectory"],
      "properties": {
        "embodiment": { "enum": ["fixture", "minecraft"] },
        "trainingContext": {
          "enum": [
            "fixture",
            "minecraft_peaceful",
            "minecraft_normal",
            "replay"
          ]
        },
        "outputDirectory": { "type": "string", "minLength": 1 },
        "rngSeed": { "type": ["integer", "null"], "minimum": 0 },
        "maxDecisions": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxTicks": { "type": "integer", "minimum": 1 },
        "decisionIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "reconnectAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "ADR 0017, I2: how many times the runtime tries to reach the world again after losing it, before ending the episode as world_unavailable. 0, the default, ends it at once."
        },
        "reconnectIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "fixtureWorld": { "type": "string", "minLength": 1 }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["off", "shadow", "supervised"],
          "description": "Learning never turns itself on. off is the default everywhere."
        },
        "evidenceDirectory": { "type": "string", "minLength": 1 },
        "snapshotEveryEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "explorationBonus": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumSupport": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "description": "ADR 0017, I3: what a death means. Read by the trusted runtime, never by cognition. respawn (the default): the same Person continues. permadeath: the Person is terminated, irreversibly; changing this afterwards resurrects no one.",
      "properties": {
        "death": { "enum": ["respawn", "permadeath"] }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Who this Person is (ADR 0017), written once into the founding event of a new continuity root. A canonical Person (personId person-NNN) is founded only by the operator's founding command.",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "designation": {
          "type": "string",
          "pattern": "^(Person|Validation)-[0-9]{3}$",
          "description": "The serial: Person-000 for a canonical Person, Validation-000 for a validation identity (ADR 0018)."
        }
      }
    },
    "deliberation": {
      "type": "object",
      "additionalProperties": false,
      "description": "ADR 0020/0021: general deliberation by a replaceable model. Read by cognition only. off (the default): nothing is invoked or recorded. record_only: triggers, requests and gates run and are recorded, reaching no behaviour. active: an admitted, planner-feasible proposal may add one temporary goal at a priority Person assigns (ADR 0021).",
      "properties": {
        "mode": { "enum": ["off", "record_only", "active"] },
        "backend": {
          "enum": ["scripted"],
          "description": "Which model answers. scripted: answers written in advance in scriptedAnswers, for offline tests and fixture runs; it makes no network call. Provider backends are chosen in C7."
        },
        "scriptedAnswers": { "type": "string", "minLength": 1 },
        "habits": {
          "enum": ["off", "record_only", "active"],
          "description": "ADR 0022: habit learning. off (the default); record_only (C4): candidates, evidence and promotion computed as a shadow stream that nothing that acts ever reads; active (C5): an active stream, from which a promoted habit answers its familiar problem without a model call. active requires mode active."
        },
        "affectArbitration": {
          "enum": ["off", "record_only", "active"],
          "description": "ADR 0023: affective metareasoning. off (the default); record_only (C6a): Person's pre-signal unease and control bands are evaluated where System-2 escalation is decided and recorded as affective_arbitration_shadow, reaching no behaviour; active (C6b): high unease or low control lowers the evidence for a non-emergency escalation by exactly one signal. record_only requires mode record_only or active; active requires mode active. Either requires affect active."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "habits": { "const": "active" } },
            "required": ["habits"]
          },
          "then": {
            "properties": { "mode": { "const": "active" } },
            "required": ["mode"]
          }
        },
        {
          "if": {
            "properties": { "affectArbitration": { "const": "active" } },
            "required": ["affectArbitration"]
          },
          "then": {
            "properties": { "mode": { "const": "active" } },
            "required": ["mode"]
          }
        },
        {
          "if": {
            "properties": { "affectArbitration": { "const": "record_only" } },
            "required": ["affectArbitration"]
          },
          "then": {
            "properties": { "mode": { "enum": ["record_only", "active"] } },
            "required": ["mode"]
          }
        }
      ]
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "How far Person's affect is switched on (ADR 0013). Read by cognition only; the runtime neither reads nor receives it.",
      "properties": {
        "mode": {
          "enum": ["off", "record_only", "active"],
          "description": "off: affect does not evolve and reaches no decision. record_only: appraised and journalled exactly as active, reaching no decision. active: the ADR 0010 behaviour. Unset means active."
        },
        "interoception": {
          "enum": ["on", "off"],
          "description": "ADR 0014: on (the default) feels the body, phasic and tonic; off reproduces R1.5 appraisal exactly, as a research baseline."
        }
      }
    },
    "cognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": "Argv of the cognition process. Node spawns it and stays authoritative if it dies."
        },
        "startTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "decisionTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "version"],
      "properties": {
        "host": { "enum": ["127.0.0.1", "localhost", "::1"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "version": { "const": "1.16.1" }
      }
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "auth"],
      "properties": {
        "username": { "type": "string", "pattern": "^[A-Za-z0-9_]{3,16}$" },
        "auth": { "const": "offline" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldOwnerApproved",
        "dedicatedIdentity",
        "resourceAreasAreUnowned",
        "naturalDaylightCycle"
      ],
      "properties": {
        "worldOwnerApproved": { "const": true },
        "dedicatedIdentity": { "const": true },
        "resourceAreasAreUnowned": { "const": true },
        "naturalDaylightCycle": { "const": true },
        "normalDifficulty": { "type": "boolean" }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "exploration", "resourceAreas", "protectedAreas"],
      "properties": {
        "home": { "$ref": "#/$defs/position" },
        "exploration": { "$ref": "#/$defs/box" },
        "resourceAreas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/box" }
        },
        "protectedAreas": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/box" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers",
        "hunting",
        "players",
        "villagers",
        "building",
        "protectedAreas"
      ],
      "properties": {
        "containers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existing", "owned"],
          "properties": {
            "existing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["withdraw", "deposit"],
              "properties": {
                "withdraw": { "type": "boolean" },
                "deposit": {
                  "const": false,
                  "description": "Person never alters a container it did not place. This value has exactly one legal setting."
                }
              }
            },
            "owned": {
              "type": "object",
              "additionalProperties": false,
              "required": ["withdraw", "deposit"],
              "properties": {
                "withdraw": { "type": "boolean" },
                "deposit": { "type": "boolean" }
              }
            }
          }
        },
        "hunting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passiveUnnamedAnimals", "namedAnimals", "tamedAnimals"],
          "properties": {
            "passiveUnnamedAnimals": { "type": "boolean" },
            "namedAnimals": { "const": false },
            "tamedAnimals": { "const": false }
          }
        },
        "players": {
          "type": "object",
          "additionalProperties": false,
          "required": ["combat"],
          "properties": { "combat": { "const": false } }
        },
        "villagers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harm"],
          "properties": { "harm": { "const": false } }
        },
        "building": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "protectedAreas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enforcement"],
          "properties": { "enforcement": { "const": "strict" } }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": "integer", "minimum": -64, "maximum": 320 },
        "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/position" },
        "max": { "$ref": "#/$defs/position" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deliberation": {
            "type": "object",
            "properties": {
              "affectArbitration": { "enum": ["record_only", "active"] }
            },
            "required": ["affectArbitration"]
          }
        },
        "required": ["deliberation"]
      },
      "then": {
        "properties": {
          "affect": {
            "type": "object",
            "properties": { "mode": { "const": "active" } }
          }
        }
      }
    }
  ]
}
