{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/schemas/emergency-event.schema.json",
  "title": "EmergencyEvent",
  "description": "Node took, or is taking, an action at L0/L1 that cognition cannot override.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "type",
    "decisionId",
    "level",
    "trigger",
    "reasonCodes",
    "action",
    "preemptedSkill"
  ],
  "properties": {
    "type": {
      "const": "EmergencyEvent"
    },
    "decisionId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "enum": ["L0", "L1"]
    },
    "trigger": {
      "$ref": "common.schema.json#/$defs/identifier",
      "description": "What made the runtime act. The vocabulary is the environment profile's (environment.json, emergency.triggers); validators check it against every installed profile."
    },
    "reasonCodes": {
      "$ref": "common.schema.json#/$defs/reasonCodes"
    },
    "action": {
      "$ref": "common.schema.json#/$defs/identifier",
      "description": "What the runtime did. The vocabulary is the environment profile's (environment.json, emergency.actions)."
    },
    "preemptedSkill": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
