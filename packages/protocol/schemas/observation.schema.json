{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/schemas/observation.schema.json",
  "title": "Observation",
  "description": "One observation, as an environment-neutral envelope around an environment-owned payload. The envelope says which experience stream it belongs to; the payload is validated by the schema of the environment profile named in experience.environmentKind (ADR 0025). Never contains raw embodiment objects.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "type",
    "observationVersion",
    "experience",
    "selfMotion",
    "cognition",
    "previousOutcome",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "Observation"
    },
    "observationVersion": {
      "type": "integer",
      "minimum": 9,
      "description": "The contract version of the observation as a whole. 9: the environment payload moved under payload, and trainingContext became experience (ADR 0025)."
    },
    "experience": {
      "$ref": "common.schema.json#/$defs/experience"
    },
    "selfMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuity", "translation", "rotation", "vertical"],
      "description": "Person's felt sense of its own motion since the previous observation, relative to its facing then (ADR 0008). No absolute position or heading.",
      "properties": {
        "continuity": {
          "enum": ["start", "continuous", "discontinuous"]
        },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "band", "distance"],
          "properties": {
            "direction": {
              "enum": [
                "ahead",
                "ahead_left",
                "ahead_right",
                "left",
                "right",
                "behind_left",
                "behind_right",
                "behind",
                "none",
                "unknown"
              ]
            },
            "band": {
              "enum": ["none", "tiny", "short", "moderate", "far", "unknown"]
            },
            "distance": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "rotation": {
          "enum": [
            "none",
            "slight_left",
            "left",
            "sharp_left",
            "about_face",
            "sharp_right",
            "right",
            "slight_right",
            "unknown"
          ]
        },
        "vertical": {
          "enum": ["level", "up", "down", "unknown"]
        }
      }
    },
    "cognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeGoal",
        "activeRoutine",
        "activeSkill",
        "suspendedGoals"
      ],
      "properties": {
        "activeGoal": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeRoutine": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeSkill": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "suspendedGoals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/slug"
          }
        }
      }
    },
    "previousOutcome": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedSkill",
            "executedSkill",
            "status",
            "effects",
            "healthCost",
            "resourceCost",
            "elapsedTicks",
            "interruptReason"
          ],
          "properties": {
            "requestedSkill": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "executedSkill": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "common.schema.json#/$defs/terminalStatus"
            },
            "effects": {
              "$ref": "common.schema.json#/$defs/reasonCodes"
            },
            "healthCost": {
              "type": "number"
            },
            "resourceCost": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "common.schema.json#/$defs/itemDelta"
              }
            },
            "elapsedTicks": {
              "type": "integer",
              "minimum": 0
            },
            "interruptReason": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/reasonCode"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "description": "Owned by the environment profile; validated against its observation payload schema."
    }
  }
}
