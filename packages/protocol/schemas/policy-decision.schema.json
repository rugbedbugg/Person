{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/schemas/policy-decision.schema.json",
  "title": "PolicyDecision",
  "description": "Cognition reports which routine it selected for the active goal and what evidence supported the choice.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "type",
    "decisionId",
    "goalId",
    "contextId",
    "routineId",
    "routineName",
    "steps",
    "confidence",
    "reasonCodes",
    "evidenceRefs",
    "policyRevision",
    "learnedOrFallback",
    "candidates",
    "shadowRoutineId"
  ],
  "properties": {
    "type": {
      "const": "PolicyDecision"
    },
    "decisionId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "goalId": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "contextId": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "routineId": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "routineName": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasonCodes": {
      "$ref": "common.schema.json#/$defs/reasonCodes"
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 0
    },
    "learnedOrFallback": {
      "enum": ["learned", "fallback"]
    },
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "routineId",
          "routineName",
          "score",
          "attempts",
          "successes",
          "meanSuccess"
        ],
        "properties": {
          "routineId": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "routineName": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "score": {
            "type": "number"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "successes": {
            "type": "integer",
            "minimum": 0
          },
          "meanSuccess": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "shadowRoutineId": {
      "description": "In shadow mode, the routine the learner would have chosen while the fallback executes.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
