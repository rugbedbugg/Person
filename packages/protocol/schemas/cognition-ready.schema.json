{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://person.local/schemas/cognition-ready.schema.json",
  "title": "CognitionReady",
  "description": "Cognition acknowledges the session and reports the state it reconstructed from evidence.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "type",
    "cognitionVersion",
    "policyRevision",
    "learningMode",
    "restoredEvents",
    "restoredRoutines",
    "snapshotTick"
  ],
  "properties": {
    "type": {
      "const": "CognitionReady"
    },
    "cognitionVersion": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 0
    },
    "learningMode": {
      "$ref": "common.schema.json#/$defs/learningMode"
    },
    "restoredEvents": {
      "type": "integer",
      "minimum": 0
    },
    "restoredRoutines": {
      "type": "integer",
      "minimum": 0
    },
    "snapshotTick": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/tick"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
